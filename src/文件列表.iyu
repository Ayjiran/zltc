<View id="16" did="10" type="ImageView">
<ppt>width=28dp
height=28dp
src=@you.png
layout_marginRight=10dp
ut_alignParentRight=true
ut_centerVertical=true</ppt>
<event><eventItme type="clicki">ulag(st_vW,5,文件名称)
f(文件名称?".")
{
	sss 文件名称=文件名称
	ug(网盘.48,"text",sss.图片路径)
	ulag(st_vW,8,sss.图片)
	uigo("查看文件.iyu")
}
else
{
	tws(v, "确定删除文件夹?", 0, "是的")
	{
		fr("$账号.txt", username)
		fr("$密码.txt", password)
		ug(网盘.48,"text",路径)
		s apiUrl = sss.api + "/api/shanchu.php"
		s targetName = 文件名称 // 要删除的目录名
		s deleteType = "dir" // 类型设为dir
		stobm(targetName, "utf-8", encodedTarget)
        stobm(路径, "utf-8", encodedFolder)
		s formData = "username=" + username + "&password=" + password + "&target_name=" + encodedTarget + "&folder_path=" + encodedFolder + "&delete_type=" + deleteType
    	t()
		{
			huf(apiUrl, formData, "", "utf-8", "", result)
			ufnsui()
			{
				syso("删除结果：" + result)
				json(result, jo)
				json(jo, "get", "msg", tip)
				f(tip ? "成功")
				{
					fn 刷新主页列表.刷新(路径)
				}
                else
                {
                	tw(tip)
                }
			}
		}
	}
}</eventItme></event>
