<event><eventItme type="clicki">ulag(st_vW,5,sss.文件名称)
f(sss.文件名称?".")
{
	ug(网盘.48,"text",sss.图片路径)
	ulag(st_vW,8,sss.图片)
	uigo("查看文件.iyu")
}
else
{
	f(sss.会员状态=="是")
	{
	ug(网盘.48,"text",路径)
    ss(路径+sss.文件名称+"/",路径)
	fn 刷新主页列表.刷新(路径)
    }
    else
    {
    	tws(v, "非会员不支持多级操控！", 0, "开通")
	{
		uigo("兑换.iyu")
	}
    }
}</eventItme></event>
</View>
