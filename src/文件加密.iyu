orientation=vertical
layout_weight=1
gravity=center</ppt>
<event><eventItme type="clicki">f(sss.会员状态=="是")
{
	gvs(ss.文件加密,19,ss.文字)
	ug(ss.文字,"text",加密文件名称)
	sr(加密文件名称," ","",加密文件名称)
	f(加密文件名称=="")
	{
		tw("请输入密码")
	}
	else
	{
		fr("$账号.txt",username)
		fr("$密码.txt",password)
		s url=username+"/"+sss.图片路径+sss.文件名称
		s code=加密文件名称
		s post_data = "username=" + username + "&userpwd=" + password + "&url=" + url + "&code=" + code + "&zuozhe=" + username
		t()
		{
			s api_url = sss.api+"/api/km.php"
			hs(api_url, post_data, "utf-8", result)
			syso(result)
			json(result, obj)
			json(obj,"get","msg",obj)
			ufnsui()
			{
				f(obj?"成功")
				{
					us(98,"text",加密文件名称)
					endutw()
				}
				else
				{
					tw(obj)
					endutw()
				}
			}
		}
	}
}
else
{
	tws(v, "非会员不支持文件加密！", 0, "开通")
	{
		uigo("兑换.iyu")
	}
}</eventItme></event>
