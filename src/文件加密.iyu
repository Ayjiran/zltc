height=-1
orientation=vertical
layout_weight=1
gravity=center</ppt>
<event><eventItme type="clicki">fr("$账号.txt",username)
fr("$密码.txt",password)
s url=username+"/"+sss.图片路径+sss.文件名称
s post_data = "username=" + username + "&possword=" + password + "&url=" + url
t()
{
	s api_url = sss.api+"/api/shanchukm.php"
	hs(api_url, post_data, "utf-8", result)
    syso(post_data)
	json(result, obj)
	json(obj,"get","msg",obj)
	ufnsui()
	{
		f(obj?"成功")
		{
			us(98,"text","暂未加密")
			endutw()
		}
		else
		{
			tw(obj)
			endutw()
		}
	}
}</eventItme></event>
