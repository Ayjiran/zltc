<View id="29" did="28" type="LinearLayout">
<ppt>width=-1
height=-1
orientation=horizontal
background=#ffe2e2e2
gravity=center</ppt>
<event><eventItme type="clicki">us(网盘.46,"text","阿里云目录/")
// 读取账号密码（SD卡根目录文件需加%，非根目录需补全路径）
fr("%账号.txt", username)
fr("%密码.txt", password)
// 拼接API地址（确保sss.api已定义，如"http://zl.ayjrw.cn"）
ss(sss.api+"/api/oss/oss.php", api)
// 拼接GET请求参数（GET方式直接拼接，无需JSON格式）
s 提交 = "username=" + username + "&password=" + password

// 开启新线程（避免阻塞主线程）
t()
{
    // 发起GET请求（参数：地址、GET数据、编码、返回结果）
    hs(api, 提交, "utf-8", dui)
    
    // 处理接口无响应场景
    f(dui == null || dui == "")
    {
        ufnsui()
        {
            us(网盘.15,"refreshing","false")
            tws(v, "接口无响应，请检查网络！", 0, "好的")
        }
        end()
    }
    
    // 解析JSON为对象（jo为完整JSON对象）
    json(dui, jo)
    
    // 1. 判断PHP返回的成功状态（success字段）
    json(jo, "get", "success", is_success)
    f(is_success != true)
    {
        // 获取错误信息（PHP返回的error字段）
        json(jo, "get", "error", err_msg)
        // 空错误信息补默认值
        f(err_msg == null || err_msg == "")
        {
            s err_msg = "未知错误"
        }
        ufnsui()
        {
            us(网盘.15,"refreshing","false")
            tws(v, "请求失败：" + err_msg, 0, "好的")
        }
        end()
    }
    
    // 2. 解析items数组（核心数据列表）
    json(jo, "get", "items", data_obj)
    // 关键修正：IApp V3.0获取数组长度用"length"而非"size"
    json(data_obj, "length", size)
    
    // 3. 处理无数据场景
    f(size == 0 || size == null)
    {
        ufnsui()
        {
            syso("无数据：阿里云目录下无文件/文件夹")
            us(网盘.15,"refreshing","false")
            us(网盘.50,"visibility","visible") // 显示无数据提示
            us(网盘.4,"visibility","gone")     // 隐藏列表
        }
        end()
    }
    
    // 4. 初始化列表数据&循环索引
    s li // 列表数据容器
    s index = 0 // 数组索引（从0开始）
    
    // 循环遍历items数组（索引&lt;长度时循环）
    w(index &lt; size)
    {
        // 解析当前索引的item（文件/文件夹对象）
        json(data_obj, index, file_item)
        
        // 解析核心字段（与PHP返回字段严格匹配）
        json(file_item, "get", "name", name)       // 名称（文件夹/文件名）
        json(file_item, "get", "last_modified", time) // 修改时间
        json(file_item, "get", "path", file_path)  // OSS完整路径
        json(file_item, "get", "type", item_type)  // 类型（folder/file）
        
        // 处理空值：修改时间为空时补默认文本
        f(time == null || time == "")
        {
            s time = "无修改时间"
        }
        // 处理空值：名称为空时补默认名
        f(name == null || name == "")
        {
            s name = "未知名称"
        }
        
        // 区分图标：文件夹/文件用不同图标（替换为你的实际图标路径）
        f(item_type == "folder")
        {
            ss("@res/folder.png", src) // 文件夹图标（需放在项目res目录）
        }
        else
        {
            ss("@res/file.png", src)   // 文件图标（需放在项目res目录）
        }
        
        // 构建列表项（参数序号需与"文件列表.iyu"模板控件ID匹配）
        // 5=名称控件ID，6=时间控件ID，14=图标控件ID，8=路径（供后续使用）
        ula(li, 5 = name, 6 = time, 14 = src, 8 = file_path, 3 = "@g/copy_icon_pic.png", 16 = "@you.png")
        
        // 索引自增（循环下一个item）
        s+(1, index)
    }
    
    // 5. 渲染列表到界面（线程中操作界面必须用ufnsui）
    ufnsui()
    {
        // 加载列表（参数：列表控件ID、列表数据、模板文件、宽度-1=自适应、高度-2=自适应）
        uls(网盘.4, li, "文件列表.iyu", -1, -2)
        us(网盘.15,"refreshing","false") // 停止刷新动画
        us(网盘.50,"visibility","gone")  // 隐藏无数据提示
        us(网盘.4,"visibility","visible")// 显示列表
    }
    break // 跳出循环
}</eventItme></event>
</View>
