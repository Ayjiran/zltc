<event><eventItme type="clicki">ug(16,"text",新密码)
f(新密码=="")
{
	tw("请输入新密码")
}
else
{
	utw(null,"","修改数据…","",true,vf)
    {
    }
	// 读取账号和原密码（假设从文件读取）
	fr("$账号.txt", username)
	fr("$密码.txt", old_password)
	// 新密码（可通过输入框获取，示例固定为12345678）
	s new_password = 新密码
	
	// 构建POST参数
	ss("username=" + username + "&old_password=" + old_password + "&new_password=" + new_password, post_data)
	stobm(post_data, "utf-8", encoded_data)
	
	// 发送请求
	t() {
		s api_url = sss.api+"/api/password.php"
		hs(api_url, encoded_data, "utf-8", result, err)
		json(err,jo)
		json(jo,"get","msg",结果)
		f(结果?"成功")
		{
			endutw(vf)
			fw("$账号.txt", username)
			fw("$密码.txt", 新密码)
            end()
		}
		else
		{
			endutw(vf)
			tw(结果)
		}
	}
}</eventItme></event>
