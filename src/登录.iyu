<View id="22" did="21" type="LinearLayout">
<ppt>width=-1
height=-1
orientation=vertical
gravity=center
background=#FFE0EDFB</ppt>
<event><eventItme type="clicki">ug(23,"text",加载)
f(加载?"加载")
{
	
}
else
{
	ug(28,"text",当前)
	f(当前=="登录账号")
	{
		ug(12,"text",username)
		ug(17,"text",password)
		f(username==""||password=="")
		{
			tw("请输入账号或者密码")
		}
		else
		{
			slg(username,长度)
            slg(password,密度)
			f(长度&lt;"6")
			{
				us(39,"visibility","visible")
                tw("账号小于六位数！")
			}
            else f(密度&lt;"6")
            {
            	us(39,"visibility","visible")
                tw("密码小于六位数！")
            }
			else
			{
				us(23,"text","加载中...")
				ss(sss.api+"/api/zhzc.php",apiUrl)
				t() {
					s postData = "{\"username\":\"" + username + "\", \"password\":\"" + password + "\"}"
					s headers = "Content-Type=application/json;charset=utf-8||User-Agent=Mozilla/5.0"
					hs(apiUrl, postData, "utf-8", result)
					syso(result)
					ufnsui()
					{
						json(result, jo)
						json(jo, "get", "code", a)
						syso(a)
						json(jo, "get", "msg", b)
						syso(b)
						f(b?"被注册了")
						{
							us(23,"text","注 册")
							tw("账号已存在/更换账号注册")
						}
						else f(b?"成功")
						{
							fr("@json/zc.json",data)
							fn Lottie.setImageLottie(6,data,0,true)
							t()
							{
								stop(2100)
								fw("$账号.txt",username)
								fw("$密码.txt",password)
								uigo("主页.iyu")
								end()
							}
						}
						else
						{
							us(23,"text","注 册")
							tw(b)
						}
					}
				}
			}
		}
	}
	else
	{
		//登录
		ug(12,"text",username)
		ug(17,"text",password)
		f(username==""||password=="")
		{
			tw("请输入账号或者密码")
		}
		else
		{
			us(23,"text","加载中...")
			ss(sss.api+"/api/zhdl.php",apiUrl)
			t() {
				s postData = "{\"username\":\"" + username + "\", \"password\":\"" + password + "\"}"
				s headers = "Content-Type=application/json;charset=utf-8||User-Agent=Mozilla/5.0"
				hs(apiUrl, postData, "utf-8", result)
				syso(result)
				ufnsui()
				{
					json(result, jo)
					json(jo, "get", "code", a)
					syso(a)
					json(jo, "get", "msg", b)
					syso(b)
					f(b?"不存在")
					{
						us(23,"text","登 录")
						tw("账号不存在，请先注册")
					}
					else f(b?"成功")
					{
						fr("@json/win.json",data)
						fn Lottie.setImageLottie(6,data,0,true)
						t()
						{
							stop(2100)
							fw("$账号.txt",username)
							fw("$密码.txt",password)
							uigo("主页.iyu")
							end()
						}
					}
					else
					{
						us(23,"text","登 录")
						tw(b)
					}
				}
			}
		}
	}
}</eventItme></event>
